# Import necessary modules for OS operations and regular expressions
import os
import re

# Import getpass for secure password input and files for Colab file uploads
from getpass import getpass
from google.colab import files

# Import various document loaders from langchain_community
from langchain_community.document_loaders import (
    WebBaseLoader, # For loading content from web pages
    Docx2txtLoader, # For loading content from DOCX files
    TextLoader # For loading content from plain text files
)

# Import Document class from langchain_core for document representation
from langchain_core.documents import Document
# Import RecursiveCharacterTextSplitter for breaking down documents into smaller chunks
from langchain_text_splitters import RecursiveCharacterTextSplitter

# Import GoogleGenerativeAIEmbeddings for generating embeddings and ChatGoogleGenerativeAI for LLM interactions
from langchain_google_genai import (
    GoogleGenerativeAIEmbeddings, # For creating vector embeddings of text
    ChatGoogleGenerativeAI # For interacting with Google's Generative AI models
)

# Import FAISS for efficient similarity search of embeddings
from langchain_community.vectorstores import FAISS

# Import TF-IDF vectorizer and cosine similarity for keyword-based search
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity

# Import pymupdf4llm for advanced PDF processing with OCR capabilities
import pymupdf4llm


# Add your Gemini API key from Colab secrets
if not os.environ.get("GOOGLE_API_KEY"):
    os.environ["GOOGLE_API_KEY"] = getpass(
        "Enter your Google API key: "
    )


# Initialize Gemini models for embeddings and chat
embeddings = GoogleGenerativeAIEmbeddings(
    model="models/gemini-embedding-001" # Specify the embedding model
)

llm = ChatGoogleGenerativeAI(
    model="gemini-3.1-flash-lite", # Specify the chat model
    temperature=0 # Set temperature to 0 for deterministic outputs
)


# Global variables to store document chunks and vector store, initialized to empty/None
# These will be rebuilt whenever a new source is loaded
chunks = [] # Stores document chunks after splitting
vector_store = None # Stores the FAISS vector index for semantic search
tfidf = None # Stores the TF-IDF vectorizer for keyword search
tfidf_matrix = None # Stores the TF-IDF matrix of the document chunks


def clean_text(text):
    """Remove unnecessary whitespace from extracted text."""
    # Use regex to replace multiple spaces with a single space and strip leading/trailing whitespace
    return re.sub(r"\s+", " ", text).strip()


def load_pdf(file_path):
    """
    Extract a PDF using PyMuPDF4LLM.

    OCR is automatic. Text-based pages are extracted normally,
    while scanned/image-based pages can be processed with OCR.
    """

    print("\nProcessing PDF...")
    print("Layout extraction + automatic OCR enabled.")

    try:
        # Attempt to extract PDF content with automatic OCR and layout preservation
        page_data = pymupdf4llm.to_markdown(
            file_path,
            page_chunks=True, # Return content per page
            use_ocr=True, # Enable OCR for image-based text
            table_strategy="lines", # Strategy for handling tables
            show_progress=True, # Show progress during extraction
            header=True, # Include headers in extraction
            footer=True # Include footers in extraction
        )

    except Exception as e:

        print(f"\nNormal PDF extraction failed: {e}")
        print("Trying full OCR...")

        # If normal extraction fails, try forcing OCR on all pages
        page_data = pymupdf4llm.to_markdown(
            file_path,
            page_chunks=True,
            use_ocr=True,
            force_ocr=True, # Force OCR on all pages
            table_strategy="lines",
            show_progress=True
        )


    docs = [] # List to store Document objects

    for page in page_data:

        text = page.get("text", "").strip() # Get the extracted text for the page

        if not text:
            continue # Skip if no text was extracted

        metadata = page.get("metadata", {}) # Get metadata for the page

        page_number = metadata.get(
            "page_number",
            len(docs) + 1 # Assign a page number if not present in metadata
        )

        docs.append(
            Document(
                page_content=clean_text(text), # Clean the extracted text
                metadata={
                    "source": file_path, # Add source file path
                    "page": page_number # Add page number to metadata
                }
            )
        )

    print(
        f"PDF extraction complete: "
        f"{len(docs)} pages produced searchable text."
    )

    return docs # Return the list of Document objects


def load_file(file_path):
    """Load PDF, DOCX or TXT automatically."""

    extension = os.path.splitext(
        file_path
    )[1].lower() # Get the file extension and convert to lowercase

    if extension == ".pdf":

        return load_pdf(file_path) # Use the PDF loader for PDF files

    elif extension == ".docx":

        docs = Docx2txtLoader(
            file_path
        ).load() # Use Docx2txtLoader for DOCX files

    elif extension == ".txt":

        docs = TextLoader(
            file_path,
            encoding="utf-8" # Use TextLoader for TXT files with UTF-8 encoding
        ).load() 

    else:

        raise ValueError(
            f"Unsupported file type: {extension}" # Raise error for unsupported file types
        )

    for doc in docs:

        doc.page_content = clean_text(
            doc.page_content
        ) # Clean the content of each document

        doc.metadata["source"] = file_path # Add the file path as the source in metadata

    return docs # Return the list of Document objects


def load_urls(urls):

    print("\nLoading URLs...")

    docs = WebBaseLoader(
        web_paths=urls
    ).load() # Load content from specified URLs

    for doc in docs:

        doc.page_content = clean_text(
            doc.page_content
        ) # Clean the content of each document

    return docs # Return the list of Document objects


def build_rag(docs):

    global chunks # Declare chunks as global to modify the global variable
    global vector_store # Declare vector_store as global
    global tfidf # Declare tfidf as global
    global tfidf_matrix # Declare tfidf_matrix as global


    if not docs:
        raise ValueError(
            "No readable content was found." # Raise error if no documents are provided
        )


    print(
        f"\nLoaded {len(docs)} document sections."
    )


    # Split the extracted content into searchable pieces
    text_splitter = RecursiveCharacterTextSplitter(
        chunk_size=800, # Define the size of each chunk
        chunk_overlap=120 # Define the overlap between chunks to maintain context
    )

    chunks = text_splitter.split_documents(
        docs
    ) # Split the documents into smaller chunks


    print(
        f"Created {len(chunks)} chunks."
    )


    # Build FAISS semantic search
    print("\nCreating FAISS index...")

    vector_store = FAISS.from_documents(
        chunks,
        embeddings
    ) # Create a FAISS index from the document chunks using Gemini embeddings


    # Build keyword search using TF-IDF
    chunk_texts = [
        chunk.page_content
        for chunk in chunks
    ] # Extract text content from each chunk


    tfidf = TfidfVectorizer(
        lowercase=True,
        stop_words="english" # Initialize TF-IDF vectorizer with lowercase and English stop words
    )


    tfidf_matrix = tfidf.fit_transform(
        chunk_texts
    ) # Fit and transform the chunk texts to create the TF-IDF matrix


    print("FAISS and keyword search are ready.")


def retrieve_documents(query):

    if vector_store is None:
        raise RuntimeError(
            "No document is loaded." # Raise error if no document has been loaded yet
        )


    # Perform semantic search using FAISS
    semantic_results = (
        vector_store.similarity_search_with_score(
            query,
            k=min(15, len(chunks)) # Retrieve top k similar documents, up to the total number of chunks
        )
    )


    semantic_scores = {} # Dictionary to store semantic scores


    for doc, distance in semantic_results:

        try:

            # Find the index of the retrieved document in the original chunks list
            index = next(
                i for i, item in enumerate(chunks)
                if item.page_content == doc.page_content
                and item.metadata == doc.metadata
            )

            # Calculate semantic score based on distance (closer is better)
            semantic_scores[index] = (
                1 / (1 + float(distance))
            )

        except StopIteration:

            continue # Continue if document not found in chunks (should not happen with FAISS.from_documents)


    # Perform keyword search using TF-IDF
    query_vector = tfidf.transform(
        [query]
    ) # Transform the query into a TF-IDF vector

    keyword_scores = cosine_similarity(
        query_vector,
        tfidf_matrix
    )[0] # Calculate cosine similarity between query and all chunk TF-IDF vectors


    # Combine both retrieval methods (semantic and keyword)
    combined_scores = {} # Dictionary to store combined scores


    for i in range(len(chunks)):

        semantic_score = semantic_scores.get(
            i,
            0
        ) # Get semantic score, default to 0 if not found

        keyword_score = float(
            keyword_scores[i]
        ) # Get keyword score

        # Weighted combination of semantic and keyword scores
        combined_scores[i] = (
            0.65 * semantic_score + # 65% weight for semantic search
            0.35 * keyword_score # 35% weight for keyword search
        )


    # Rank documents based on combined scores
    ranked_indexes = sorted(
        combined_scores,
        key=combined_scores.get,
        reverse=True # Sort in descending order of scores
    )


    # Determine if the query is a list-type question to adjust retrieval count
    list_question = any(
        word in query.lower()
        for word in [
            "list", "all websites", "which websites", "what websites",
            "names of", "websites are", "how many", "all"
        ]
    )


    top_k = 15 if list_question else 6 # Retrieve more documents for list questions

    top_k = min(
        top_k,
        len(chunks)
    ) # Ensure top_k does not exceed the total number of chunks


    return [
        chunks[i]
        for i in ranked_indexes[:top_k]
    ] # Return the top k ranked document chunks

system_prompt = """
You are a document and web-source question-answering assistant.

The provided context may come from:
1. Uploaded PDF, DOCX, or TXT files
2. One or more web URLs

Use only the information available in the retrieved context to answer
the user's question.

Important rules:

- Treat uploaded documents and web pages as valid knowledge sources.
- Answer using the retrieved context, not outside knowledge.
- Combine information from multiple retrieved chunks when necessary.
- If the same information appears in multiple sources, combine it clearly.
- Preserve website names, URLs, document names, numbers, dates, and technical
  terms as they appear in the source.
- Do not invent missing information.
- Do not assume that a URL or document contains information unless it appears
  in the retrieved context.
- For list questions, return all relevant items supported by the retrieved
  context.
- For comparison questions, compare only information supported by the sources.
- When the answer comes from a specific PDF page, mention the page number
  when available.
- When the answer comes from a URL, mention the source URL when available.
- When multiple sources support an answer, identify the relevant sources.

If the retrieved context does not contain enough information to answer the
question, say:

"I don't have enough information in the provided sources."

Retrieved Context:
{context}

User Query:
{query}

Answer:
""" # The system prompt instructing the LLM on how to answer questions


def ask_question(user_query):

    retrieved_docs = retrieve_documents(
        user_query
    ) # Retrieve relevant documents based on the user's query


    context_parts = [] # List to store formatted context parts


    for i, doc in enumerate(
        retrieved_docs,
        1
    ):

        source = doc.metadata.get(
            "source",
            "Unknown source"
        ) # Get the source of the document

        page = doc.metadata.get(
            "page"
        ) # Get the page number if available


        if page:

            location = (
                f"Source: {source} | "
                f"Page: {page}" # Format location with page number
            )

        else:

            location = (
                f"Source: {source}" # Format location without page number
            )


        context_parts.append(
            f"Document Chunk {i}\n"
            f"{location}\n"
            f"{doc.page_content}"
        ) # Add formatted document chunk to context parts


    context = "\n\n".join(
        context_parts
    ) # Join all context parts into a single string


    final_prompt = system_prompt.format(
        context=context,
        query=user_query
    ) # Format the system prompt with the retrieved context and user query


    response = llm.invoke(
        final_prompt
    ) # Invoke the LLM with the final prompt to get the answer


    answer = response.content # Extract the answer content from the LLM response


    if isinstance(answer, list):

        answer = "\n".join(
            item.get("text", str(item))
            if isinstance(item, dict)
            else str(item)
            for item in answer
        ) # Handle cases where the answer might be a list of items


    print("\n1. SYSTEM PROMPT")
    print(
        system_prompt
        .replace(
            "{context}",
            "[Retrieved document context]"
        )
        .replace(
            "{query}",
            user_query
        )
    ) # Print the system prompt (with context placeholder)


    print("\n2. QUERY")
    print(user_query) # Print the user's query


    print("\n3. RETRIEVED CONTEXT")

    for i, doc in enumerate(
        retrieved_docs,
        1
    ):

        print(f"\nChunk {i}:") # Print chunk number

        if "page" in doc.metadata:

            print(
                f"Page: {doc.metadata['page']}"
            ) # Print page number if available

        print(
            doc.page_content[:1000]
        ) # Print a truncated version of the chunk content


    print("\n4. ANSWER")
    print(answer) # Print the LLM's answer


def load_source():

    print("\nSelect your source:")
    print("1. URLs")
    print("2. Upload PDF / DOCX / TXT")
    print("3. Exit")


    choice = input(
        "\nEnter 1, 2 or 3: "
    ).strip() # Get user's choice for source loading


    if choice == "1":

        url_input = input(
            "\nEnter URL(s), separated by commas:\n"
        ).strip() # Get URLs from user input


        urls = [
            url.strip()
            for url in url_input.split(",")
            if url.strip()
        ] # Parse comma-separated URLs


        if not urls:

            print(
                "No URLs were entered."
            )

            return False # Return False if no URLs provided


        docs = load_urls(
            urls
        ) # Load documents from URLs


    elif choice == "2":

        print(
            "\nUpload one or more PDF, DOCX or TXT files."
        )


        uploaded = files.upload() # Prompt user to upload files


        if not uploaded:

            print(
                "No file was uploaded."
            )

            return False # Return False if no files uploaded


        docs = [] # List to store documents from uploaded files


        for file_path in uploaded.keys():

            print(
                f"\nProcessing: {file_path}"
            )


            try:

                file_docs = load_file(
                    file_path
                ) # Load documents from each uploaded file

                docs.extend(
                    file_docs
                ) # Add loaded documents to the list

            except Exception as e:

                print(
                    f"Could not load {file_path}: {e}"
                )


    elif choice == "3":

        return None # Return None to signal exit


    else:

        print(
            "Invalid choice."
        )

        return False # Return False for invalid choice


    if not docs:

        print(
            "No readable document content found."
        )

        return False # Return False if no readable content was found


    build_rag(
        docs
    ) # Build the RAG system with the loaded documents


    return True # Return True if source loaded successfully


# Load the first source when the notebook starts
status = load_source()


if status is None:

    print("\nExited.") # Print exit message if user chose to exit


elif status:

    # Keep running until the user explicitly chooses Exit
    while True:

        print(
            "\n" + "=" * 60
        )

        print(
            "RAG is ready. Ask a question."
        )

        print(
            "Type 'menu' to load another document or exit."
        )


        user_query = input(
            "\nEnter your question: "
        ).strip() # Get user's question


        if not user_query:

            continue # Continue if query is empty


        if user_query.lower() == "menu":

            status = load_source() # Load another source or exit


            if status is None:

                print(
                    "\nExited."
                )

                break # Break loop if user chose to exit


            continue # Continue to next iteration if new source loaded


        try:

            ask_question(
                user_query
            ) # Ask the question using the RAG system

        except Exception as e:

            print(
                f"\nError while answering: {e}"
            )


        print(
            "\nWhat would you like to do next?"
        )

        print(
            "1. Ask another question"
        )

        print(
            "2. Load a new document / URL"
        )

        print(
            "3. Exit"
        )


        next_action = input(
            "\nEnter 1, 2 or 3: "
        ).strip() # Get user's choice for next action


        if next_action == "1":

            continue # Ask another question


        elif next_action == "2":

            status = load_source() # Load a new document or URL


            if status is None:

                print(
                    "\nExited."
                )

                break # Break loop if user chose to exit


            continue # Continue to next iteration if new source loaded


        elif next_action == "3":

            print(
                "\nRAG session ended."
            )

            break # Exit the RAG session


        else:

            print(
                "\nInvalid choice. Continuing..." # Handle invalid choice
            )
